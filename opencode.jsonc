{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-5.6-luna",
  "small_model": "openai/gpt-5.6-luna",

  "instructions": ["AGENTS.md"],

  "default_agent": "build",

  "agent": {
    "build": {
      "model": "openai/gpt-5.6-luna",
      "description": "Primary agent for normal development: feature implementation, refactoring, tests, documentation, UI work, and bug fixes. Delegates to subagents when appropriate."
    },
    "plan": {
      "model": "openai/gpt-5.6-luna",
      "description": "Analyzes requirements, architecture, and implementation approach before significant changes."
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "description": "Fast exploration: finds files, searches code, answers questions about the codebase."
    }
  },

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": {
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "git branch": "allow",
      "git show": "allow",
      "git pull": "allow",
      "git stash": "allow",
      "git stash list": "allow",
      "git remote -v": "allow",
      "node": "ask",
      "npm": "ask",
      "npx": "ask",
      "curl": "ask",
      "*": "ask"
    },
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "deny"
  },

  "compaction": {
    "auto": true,
    "tail_turns": 15
  }
}
