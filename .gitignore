# Local data assets — offline-only backups, not used at runtime.
# Golden source is Upstash Redis via Cloudflare Worker API.
*.xlsx
data/*
!data/.gitkeep
!build-info.json

# Local tooling / build artifacts — never served, never committed.
.playwright-mcp/
node_modules/
playwright-report/
test-results/
worker/.wrangler/
worker/migration.json

# Local secrets — one-time entry, never committed, publicly-served repo.
# Consumed by the upstash-redis MCP server via {env:...} substitution.
upstash.env
.upstash*
